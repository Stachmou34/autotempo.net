# ── Sécurité de base ──────────────────────────────────────────────
Options -Indexes

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Bloque l'accès direct aux fichiers sensibles (.md, .sql, .gitignore…).
<IfModule mod_authz_core.c>
    # Apache 2.4+
    <FilesMatch "(\.(md|sql|gitignore)$|^_htaccess)">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    # Apache 2.2
    <FilesMatch "(\.(md|sql|gitignore)$|^_htaccess)">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>

# Page d'accueil.
DirectoryIndex index.php index.html
